# Copy to .env and fill in. Leave Google values empty to run on sample data.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
GA4_PROPERTY_ID=
GSC_SITE_URL=sc-domain:wepsol.com
WP_BASE=https://wepsol.com

# Report definition (defaults shown)
WEEK_ANCHOR=2026-11-17
INDIA_COUNTRY=India
TARGET_MONTHLY_TRAFFIC=3000
TARGET_WEEKLY_TRAFFIC=650
TARGET_AVG_SESSION_SEC=200

# LinkedIn admin analytics come from the 'LinkedIn Analytics' tab of the reporting Google Sheet. Pick ONE:
#  1) service account: create a Google Cloud project you own, enable the Sheets API, create a service account, share the sheet with its
#     e-mail as Viewer, then point to its JSON key:
# GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json
#  2) a CSV export of the tab saved as tracker/data/linkedin_analytics.csv (File > Download > CSV)
# On Vercel (no files): paste the service-account key's JSON text into this variable instead of using a file:
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={...the whole JSON key on one line...}
